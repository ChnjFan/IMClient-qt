QDialog#LoginDialog, #RegisterDialog {
background-color:rgb(255,255,255)
}

#user_label, #passwd_label {
    color:black;
}

#err_tip[state='normal'] {
    color:green;
}

#err_tip[state='err'] {
    color:red;
}

#passwd_visible[state='unvisible'] {
    border-image: url(:/resource/icon/hiden.svg);
}

#passwd_visible[state='unvisible_hover'] {
    border-image: url(:/resource/icon/hiden_hover.svg);
}

#passwd_visible[state='visible'] {
    border-image: url(:/resource/icon/view.svg);
}

#passwd_visible[state='visible_hover'] {
    border-image: url(:/resource/icon/view_hover.svg);
}

#ack_visible[state='unvisible'] {
    border-image: url(:/resource/icon/hiden.svg);
}

#ack_visible[state='unvisible_hover'] {
    border-image: url(:/resource/icon/hiden_hover.svg);
}

#ack_visible[state='visible'] {
    border-image: url(:/resource/icon/view.svg);
}

#ack_visible[state='visible_hover'] {
    border-image: url(:/resource/icon/view_hover.svg);
}